FUN_000200-T1	eggNOG-mapper	CDS	1	428	744.0	+	.	ID=FUN_000200-T1;em_target=1041607.K0KR80;em_score=744.0;em_evalue=3.57e-270;em_tcov=100.0;em_searcher=diamond;em_OGs=COG0476@1|root,KOG2017@2759|Eukaryota,38E2S@33154|Opisthokonta,3NZDJ@4751|Fungi,3QNXR@4890|Ascomycota,3RSFG@4891|Saccharomycetes;em_COG_cat=H;em_desc=Plays a central role in 2-thiolation of mcm(5)S(2)U at tRNA wobble positions of cytosolic tRNA(Lys), tRNA(Glu) and tRNA(Gln). Acts by mediating the C-terminal thiocarboxylation of sulfur carrier URM1. Its N-terminus first activates URM1 as acyl- adenylate (-COAMP), then the persulfide sulfur on the catalytic cysteine is transferred to URM1 to form thiocarboxylation (-COSH) of its C-terminus. The reaction probably involves hydrogen sulfide that is generated from the persulfide intermediate and that acts as nucleophile towards URM1. Subsequently, a transient disulfide bond is formed. Does not use thiosulfate as sulfur donor;em_max_annot_lvl=4751|Fungi;em_Preferred_name=cnxF;em_PFAMs=Rhodanese,ThiF;em_EC=2.7.7.80,2.8.1.11;em_KEGG_ko=ko:K11996;em_KEGG_Pathway=ko04122,map04122;em_KEGG_Reaction=R07459,R07461;em_KEGG_rclass=RC00043;em_BRITE=ko00000,ko00001,ko01000,ko03016,ko04121;em_GOs=GO:0000003,GO:0001403,GO:0001558,GO:0002097,GO:0002098,GO:0002143,GO:0003674,GO:0003824,GO:0004792,GO:0005575,GO:0005622,GO:0005623,GO:0005737,GO:0006139,GO:0006396,GO:0006399,GO:0006400,GO:0006464,GO:0006725,GO:0006807,GO:0006950,GO:0006979,GO:0007114,GO:0008033,GO:0008150,GO:0008152,GO:0008641,GO:0009451,GO:0009987,GO:0010467,GO:0010570,GO:0016070,GO:0016740,GO:0016772,GO:0016779,GO:0016782,GO:0016783,GO:0016874,GO:0016877,GO:0018117,GO:0018175,GO:0019538,GO:0019954,GO:0030447,GO:0032446,GO:0032447,GO:0032505,GO:0033554,GO:0034227,GO:0034470,GO:0034599,GO:0034641,GO:0034660,GO:0036211,GO:0036267,GO:0040007,GO:0040008,GO:0042221,GO:0042292,GO:0043170,GO:0043412,GO:0044182,GO:0044237,GO:0044238,GO:0044260,GO:0044267,GO:0044424,GO:0044464,GO:0046483,GO:0050789,GO:0050794,GO:0050896