FUN_002439-T1	eggNOG-mapper	CDS	1	107	148.0	+	.	ID=FUN_002439-T1;em_target=1041607.K0KCK4;em_score=148.0;em_evalue=2.22e-45;em_tcov=100.0;em_searcher=diamond;em_OGs=COG5131@1|root,KOG4146@2759|Eukaryota,3A8YT@33154|Opisthokonta,3P6W9@4751|Fungi,3QWKZ@4890|Ascomycota,3RV9B@4891|Saccharomycetes;em_COG_cat=O;em_desc=Acts as a sulfur carrier required for 2-thiolation of mcm(5)S(2)U at tRNA wobble positions of cytosolic tRNA(Lys), tRNA(Glu) and tRNA(Gln). Serves as sulfur donor in tRNA 2- thiolation reaction by being thiocarboxylated (-COSH) at its C- terminus by the MOCS3 homolog UBA4. The sulfur is then transferred to tRNA to form 2-thiolation of mcm(5)S(2)U. Prior mcm(5) tRNA modification by the elongator complex is required for 2- thiolation. Also acts as a ubiquitin-like protein (UBL) that is covalently conjugated via an isopeptide bond to lysine residues of target proteins such as AHP1. The thiocarboxylated form serves as substrate for conjugation and oxidative stress specifically induces the formation of UBL-protein conjugates;em_max_annot_lvl=4751|Fungi;em_Preferred_name=URM1;em_PFAMs=Urm1;em_KEGG_ko=ko:K12161;em_KEGG_Pathway=ko04122,map04122;em_BRITE=ko00000,ko00001,ko03016,ko04121;em_GOs=GO:0000003,GO:0001403,GO:0002097,GO:0002098,GO:0002143,GO:0003674,GO:0005575,GO:0005622,GO:0005623,GO:0005634,GO:0005737,GO:0005829,GO:0006139,GO:0006396,GO:0006399,GO:0006400,GO:0006464,GO:0006725,GO:0006807,GO:0006950,GO:0006979,GO:0007114,GO:0008033,GO:0008150,GO:0008152,GO:0009451,GO:0009987,GO:0010467,GO:0016070,GO:0019538,GO:0019954,GO:0030447,GO:0031386,GO:0032446,GO:0032447,GO:0032505,GO:0033554,GO:0034227,GO:0034470,GO:0034599,GO:0034641,GO:0034660,GO:0036211,GO:0036267,GO:0040007,GO:0042221,GO:0043170,GO:0043226,GO:0043227,GO:0043229,GO:0043231,GO:0043412,GO:0044182,GO:0044237,GO:0044238,GO:0044260,GO:0044267,GO:0044424,GO:0044444,GO:0044464,GO:0046483,GO:0050896,GO:0051301,GO:0051716,GO:0070647,GO:0070783,GO:0070887,GO:0071704,GO:0090304,GO:1901360,GO:1901564
